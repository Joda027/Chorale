generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CHORISTE
  MAITRE_CHOEUR
  PRESIDENT
  SECRETAIRE_GENERAL
  TRESORIER
  CHARGE_ORGANISATION
  CHARGE_SPIRITUEL
  CHARGE_DISCIPLINE
}

enum Pupitre {
  SOPRANO
  ALTO
  TENOR
  BASSE
}

enum StatutMembre {
  ACTIF
  INACTIF
}

enum TypeActivite {
  REPETITION
  RETRAITE
  FORMATION
  AUTRE
}

enum TypeEvenement {
  MESSE
  MARIAGE
  FUNERAILLES
  CONCERT
  AUTRE
}

enum TypeDocument {
  PV_REUNION
  COMPTE_RENDU
  COURRIER
  AUTRE
}

enum StatutAction {
  A_FAIRE
  EN_COURS
  TERMINE
  ANNULE
}

enum TypeTransaction {
  RECETTE
  DEPENSE
}

model Membre {
  id            String       @id @default(cuid())
  nom           String
  prenom        String
  email         String       @unique
  telephone     String?
  motDePasse    String
  photoUrl      String?
  pupitre       Pupitre?
  statut        StatutMembre @default(ACTIF)
  dateAdhesion  DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  roles              MembreRole[]
  presences          Presence[]
  documentsAjoutes   Document[]     @relation("DocumentUploadePar")
  actionsResponsable PlanAction[]   @relation("ActionResponsable")
  transactions       Transaction[]  @relation("TransactionCreateePar")
}

model MembreRole {
  id        String    @id @default(cuid())
  membreId  String
  membre    Membre    @relation(fields: [membreId], references: [id], onDelete: Cascade)
  role      Role
  dateDebut DateTime  @default(now())
  dateFin   DateTime?

  @@unique([membreId, role, dateDebut])
}

model Chant {
  id               String   @id @default(cuid())
  titre            String
  compositeur      String?
  pupitreCible     Pupitre?
  tonalite         String?
  niveauDifficulte String?
  partitionUrl     String?
  audioUrl         String?
  paroles          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tags              Tag[]
  prestationChants  PrestationChant[]
}

model Tag {
  id     String  @id @default(cuid())
  nom    String  @unique
  chants Chant[]
}

model Activite {
  id          String       @id @default(cuid())
  titre       String
  type        TypeActivite
  dateDebut   DateTime
  dateFin     DateTime?
  lieu        String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  presences Presence[]
}

model Prestation {
  id           String        @id @default(cuid())
  titre        String
  typeEvenement TypeEvenement
  date         DateTime
  lieu         String?
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  chants    PrestationChant[]
  presences Presence[]
}

model PrestationChant {
  id           String     @id @default(cuid())
  prestationId String
  prestation   Prestation @relation(fields: [prestationId], references: [id], onDelete: Cascade)
  chantId      String
  chant        Chant      @relation(fields: [chantId], references: [id], onDelete: Cascade)
  ordre        Int?

  @@unique([prestationId, chantId])
}

model Presence {
  id           String      @id @default(cuid())
  membreId     String
  membre       Membre      @relation(fields: [membreId], references: [id], onDelete: Cascade)
  activiteId   String?
  activite     Activite?   @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  prestationId String?
  prestation   Prestation? @relation(fields: [prestationId], references: [id], onDelete: Cascade)
  present      Boolean     @default(true)
  remarque     String?

  @@unique([membreId, activiteId, prestationId])
}

model Document {
  id             String       @id @default(cuid())
  titre          String
  type           TypeDocument
  fichierUrl     String
  dateDocument   DateTime     @default(now())
  uploadeParId   String
  uploadePar     Membre       @relation("DocumentUploadePar", fields: [uploadeParId], references: [id])
  createdAt      DateTime     @default(now())
}

model PlanAction {
  id             String       @id @default(cuid())
  titre          String
  description    String?
  objectif       String?
  dateEcheance   DateTime?
  statut         StatutAction @default(A_FAIRE)
  responsableId  String?
  responsable    Membre?      @relation("ActionResponsable", fields: [responsableId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Transaction {
  id           String          @id @default(cuid())
  type         TypeTransaction
  montant      Float
  description  String?
  categorie    String?
  date         DateTime        @default(now())
  creeParId    String
  creePar      Membre          @relation("TransactionCreateePar", fields: [creeParId], references: [id])
  createdAt    DateTime        @default(now())
}
